{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workbuddy.local/kpop-daily.schema.json",
  "title": "KPOP 日报数据契约 (KPOP Daily Data Contract)",
  "description": "借鉴 AI HOT 的统一条目模型, 扩展 KPOP 实体标签(groups/idols/company)与榜单共识字段。定义日报成品 DailyReport 与条目 Item。所有时间转 Asia/Seoul (KST, +09:00)。",
  "$defs": {
    "SourceType": {
      "enum": ["news", "video", "social", "chart"],
      "description": "信源性质: news=新闻RSS, video=YouTube, social=Bluesky/Reddit 等, chart=音乐榜单"
    },
    "Category": {
      "enum": ["comeback", "stage", "trend", "event", "chart"],
      "description": "对应 5 个固定版块: comeback=回归·新曲, stage=舞台·打歌, trend=热点·话题, event=官宣·事件, chart=数据·榜单"
    },
    "Lang": {
      "enum": ["ko", "en", "ja", "zh", "other"],
      "description": "原文语种, 供 KO/EN→ZH 摘要层路由"
    },
    "Source": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "description": "源显示名, 如 Soompi / Allkpop / YouTube / Bluesky / Bugs / Circle" },
        "type": { "$ref": "#/$defs/SourceType" }
      }
    },
    "Links": {
      "type": "object",
      "required": ["original"],
      "properties": {
        "original": { "type": "string", "format": "uri", "description": "原文跳转链接 (target=_blank rel=noopener noreferrer)" },
        "aihot": { "type": ["string", "null"], "description": "保留字段, KPOP 日报恒为 null (无 AI HOT 桥接)" }
      }
    },
    "Item": {
      "type": "object",
      "required": ["id", "title", "summary", "source", "links", "publishedAt", "discoveredAt", "category", "groups", "selected"],
      "properties": {
        "id": { "type": "string", "description": "条目唯一 ID, 建议 sha1(originalUrl)" },
        "title": { "type": "string", "description": "中文标题 (KO/EN→ZH 摘要层生成)" },
        "originalTitle": { "type": "string", "description": "原文标题 (KO/EN); 未翻译时与 title 同值" },
        "summary": { "type": "string", "maxLength": 60, "description": "≤60 字中文摘要" },
        "source": { "$ref": "#/$defs/Source" },
        "links": { "$ref": "#/$defs/Links" },
        "publishedAt": { "type": "string", "format": "date-time", "description": "发布时间, 转 Asia/Seoul (KST, +09:00)" },
        "discoveredAt": { "type": "string", "format": "date-time", "description": "抓取 worker 发现时间 (UTC 或 KST 均可, 展示层统一转 KST)" },
        "category": { "$ref": "#/$defs/Category" },
        "groups": {
          "type": "array",
          "items": { "type": "string" },
          "description": "关联团体标签, 如 [\"BTS\",\"NewJeans\"]; 由 Wikidata 实体表归一, 可空但建议非空"
        },
        "idols": { "type": "array", "items": { "type": "string" }, "description": "关联成员标签, 如 [\"Haerin\"]" },
        "company": { "type": "string", "description": "经纪公司, 来自 Wikidata 实体表, 如 HYBE / BIGHIT MUSIC" },
        "score": { "type": ["number", "null"], "description": "热度/编辑评分, 无则 null" },
        "selected": { "type": "boolean", "description": "是否入选日报 (编辑精选层, 去噪后为真)" },
        "lang": { "$ref": "#/$defs/Lang" },
        "consensusRank": { "type": "integer", "minimum": 1, "description": "[chart 专用] 三源 Borda 共识排名" },
        "perSourceRank": {
          "type": "object",
          "additionalProperties": { "type": "integer" },
          "description": "[chart 专用] 各源原始排名, 如 {\"circle\":1,\"melon\":3,\"bugs\":2}"
        },
        "spread": { "type": "integer", "minimum": 0, "description": "[chart 专用] 跨源排名最大差 = 分歧度" },
        "coverage": { "type": "integer", "minimum": 1, "maximum": 3, "description": "[chart 专用] 出现源数 (1~3)" },
        "versions": { "type": "array", "items": { "type": "string" }, "description": "[chart 专用] 收集到的版本标记, 如 [\"spotify edit\"] (版本级归一)" },
        "multiVersion": { "type": "boolean", "description": "[chart 专用] 跨源是否出现多个版本" },
        "dateMismatch": { "type": "boolean", "description": "[chart 专用] 跨源榜单快照日期是否不一致 (KST, 日期对齐)" },
        "dupCount": { "type": "integer", "minimum": 1, "description": "[可选] 语义去重后合并的同源重复条数 (热点版块降噪用)" }
      },
      "allOf": [
        {
          "if": { "properties": { "category": { "const": "chart" } } },
          "then": { "required": ["consensusRank", "perSourceRank"] }
        }
      ]
    },
    "Section": {
      "type": "object",
      "required": ["label", "items"],
      "properties": {
        "label": { "type": "string", "description": "版块名, 固定 5 个之一 (见契约文档)" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/Item" } }
      }
    },
    "Flash": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "description": "快讯正文 (≤40 字)" },
        "link": { "type": ["string", "null"], "format": "uri" },
        "source": { "type": ["string", "null"] }
      }
    },
    "Attribution": {
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "string" }, "description": "数据来源清单 (合规保留, 不可省略)" },
        "note": { "type": "string", "description": "合规/版权说明, 如 '内容归原媒体所有, 仅作聚合索引'" }
      }
    },
    "DailyReport": {
      "type": "object",
      "required": ["date", "generatedAt", "windowStart", "windowEnd", "lead", "sections", "attribution"],
      "properties": {
        "date": { "type": "string", "format": "date", "description": "日报日期 YYYY-MM-DD (KST)" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "windowStart": { "type": "string", "format": "date-time", "description": "收录窗口起 (KST)" },
        "windowEnd": { "type": "string", "format": "date-time", "description": "收录窗口止 (KST)" },
        "lead": { "type": "string", "description": "头条导语 (1~2 句)" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/Section" },
          "minItems": 5,
          "maxItems": 5,
          "description": "5 个固定版块, 顺序: 回归→舞台→热点→官宣→数据"
        },
        "flashes": { "type": "array", "items": { "$ref": "#/$defs/Flash" }, "description": "快讯流 (Hero 区用), 可空" },
        "attribution": { "$ref": "#/$defs/Attribution" },
        "totalCount": { "type": "integer", "description": "全版块条目总数 (不含 flashes), 文末标注用" }
      }
    }
  },
  "$ref": "#/$defs/DailyReport"
}
